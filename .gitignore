# ==========================================
# Dependencies (Bibliotecas e Módulos)
# ==========================================
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# Production & Builds
# ==========================================
/build
/dist
/.next/
/out/

# ==========================================
# Environment Variables (MUITO IMPORTANTE!)
# Guarde suas chaves de API e segredos aqui
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Exceptions: pode versionar o exemplo se tiver
!.env.example

# ==========================================
# Logs & Debugging
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Testing & Coverage
# ==========================================
/coverage
/.nyc_output

# ==========================================
# Next.js & Framework Caches
# ==========================================
.vercel
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Editors & IDEs (VS Code, WebStorm, etc)
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# OS Generated Files (Arquivos do Sistema)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db